#
# Optional: source this if you keep a bare-metal ARM toolchain outside PATH.
# The Makefile finds arm-none-eabi-gcc on PATH by default and only falls back
# to this location when it is not there.
export GBA_TOOLCHAIN="$HOME/.local/share/gba-toolchain/root/usr"
export PATH="$GBA_TOOLCHAIN/bin:$PATH"
